<Application
    x:Class="PoChopAudio.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PoChopAudio.WinUI"
    xmlns:common="using:PoChopAudio.WinUI.Common">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Glass for the cards. Acrylic rather than a flat fill because the pages now sit on a
                shader-driven gradient: an opaque card over it reads as a hole punched in the page,
                where a translucent one lets the colour beneath show through and the two look like
                one surface.

                Defined per theme rather than once with a ThemeResource tint, because a brush
                created in a shared dictionary resolves its colours a single time and would keep
                the theme it was first built under. The same reasoning applies to every brush in
                these dictionaries.
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <AcrylicBrush x:Key="GlassCardBrush"
                                  TintColor="#FFFFFF"
                                  TintOpacity="0.35"
                                  TintLuminosityOpacity="0.85"
                                  FallbackColor="#FAFAFA" />
                    <AcrylicBrush x:Key="GlassPanelBrush"
                                  TintColor="#FFFFFF"
                                  TintOpacity="0.18"
                                  TintLuminosityOpacity="0.78"
                                  FallbackColor="#F3F3F3" />

                    <!--
                        Danger and warning, previously hex literals scattered through the pages.
                        Light theme darkens the reds: #EF4444 as body text on the light card
                        measures about 3.6:1, under the 4.5:1 that WCAG AA asks of small text,
                        where #B91C1C measures about 5.9:1.

                        The record button's red is not here. It has to override the accent
                        template's own resource keys, which only works in that button's local
                        theme dictionaries - see the comment on it in ChopPage.xaml.
                    -->
                    <SolidColorBrush x:Key="DangerFillBrush" Color="#DC2626" />
                    <SolidColorBrush x:Key="OnDangerFillBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="DangerTextBrush" Color="#B91C1C" />
                    <SolidColorBrush x:Key="ErrorTextBrush" Color="#B91C1C" />
                    <SolidColorBrush x:Key="ErrorBannerBrush" Color="#22DC2626" />
                    <SolidColorBrush x:Key="WarnBadgeBrush" Color="#F59E0B" />
                    <SolidColorBrush x:Key="WarnBadgeTextBrush" Color="#000000" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <AcrylicBrush x:Key="GlassCardBrush"
                                  TintColor="#1B1F27"
                                  TintOpacity="0.45"
                                  TintLuminosityOpacity="0.80"
                                  FallbackColor="#202126" />
                    <AcrylicBrush x:Key="GlassPanelBrush"
                                  TintColor="#12151B"
                                  TintOpacity="0.30"
                                  TintLuminosityOpacity="0.72"
                                  FallbackColor="#1A1C21" />

                    <SolidColorBrush x:Key="DangerFillBrush" Color="#DC2626" />
                    <SolidColorBrush x:Key="OnDangerFillBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="DangerTextBrush" Color="#F87171" />
                    <SolidColorBrush x:Key="ErrorTextBrush" Color="#F87171" />
                    <SolidColorBrush x:Key="ErrorBannerBrush" Color="#33EF4444" />
                    <SolidColorBrush x:Key="WarnBadgeBrush" Color="#F59E0B" />
                    <SolidColorBrush x:Key="WarnBadgeTextBrush" Color="#000000" />
                </ResourceDictionary>

                <!--
                    High contrast must stay opaque: translucency destroys the guaranteed ratios.
                    For the same reason nothing here invents a colour — every value is a system
                    colour the user chose, so a red that the theme never agreed to cannot leak in.
                -->
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="GlassCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="GlassPanelBrush" Color="{ThemeResource SystemColorWindowColor}" />

                    <SolidColorBrush x:Key="DangerFillBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="OnDangerFillBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="DangerTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="ErrorTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="ErrorBannerBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="WarnBadgeBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="WarnBadgeTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!--
                Converters, once. Every page used to declare its own copy of these five, so a
                three-page app held fifteen instances and re-created them on each navigation.
                StaticResource lookup walks up to the application dictionary, so the pages still
                reference them by the same keys.
            -->
            <common:BoolToVisibilityConverter x:Key="BoolToVis" />
            <common:BoolToVisibilityConverter x:Key="InvertedBoolToVis" Invert="True" />
            <common:InvertedBoolConverter x:Key="InvertBool" />
            <common:NullToVisibilityConverter x:Key="NullToVis" />
            <common:LabelWithValueConverter x:Key="RowLabel" />
            <common:EnumToIndexConverter x:Key="EnumToIndex" />

            <!--
                One card shape for the whole app. Chop and Cutout repeated these five setters
                inline six times between them and Settings carried a near-identical private copy.
                Padding is the one thing instances legitimately vary, so it is set here as the
                common case and overridden locally where a card needs more room.
            -->
            <Style x:Key="GlassCard" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource GlassCardBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="20,16" />
            </Style>

            <!-- Section label above a group of cards. -->
            <!--
                HeadingLevel is what turns these from decorative bold text into landmarks a screen
                reader can jump between. Without it the Settings page is one flat run of text.
            -->
            <Style x:Key="SectionHeading" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
                <Setter Property="Margin" Value="2,8,0,0" />
            </Style>

            <!-- Secondary explanatory text. On the type ramp rather than a bare FontSize. -->
            <Style x:Key="HintText" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <!-- A filesystem path the user may want to copy. Consolas is not on every install. -->
            <Style x:Key="PathText" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Segoe UI" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <!-- The label / value pair that sits above every slider on the tuning panels. -->
            <Style x:Key="KnobValueText" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

<UserControl
    x:Class="PoChopAudio.WinUI.Controls.ShaderBackdrop"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:win2d="using:Microsoft.Graphics.Canvas.UI.Xaml"
    IsHitTestVisible="False"
    AutomationProperties.AccessibilityView="Raw">

    <!--
        Decoration only, so it is invisible to hit testing and to assistive tech: an animated
        gradient is not something a screen reader should ever announce or a click should ever land
        on.

        CanvasControl rather than CanvasAnimatedControl. The animated one is backed by a
        SwapChainPanel, which composites in its own layer and paints straight over the sibling XAML
        it is supposed to sit behind - the page content vanished entirely. CanvasControl draws into
        an image source that composites in the visual tree like any other element, so z-order works.
        Frames are driven by CompositionTarget.Rendering instead.
    -->
    <win2d:CanvasControl x:Name="Surface"
                         Draw="OnDraw"
                         ClearColor="Transparent"
                         IsHitTestVisible="False" />
</UserControl>

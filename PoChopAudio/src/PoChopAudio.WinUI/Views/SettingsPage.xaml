<Page
    x:Class="PoChopAudio.WinUI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:PoChopAudio.WinUI.Common"
    xmlns:services="using:PoChopAudio.WinUI.Services"
    xmlns:shapes="using:Microsoft.UI.Xaml.Shapes"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!--
            The shared converters and the card, heading, hint and path styles are in App.xaml. Only
            this converter stays local, because this is the one page that uses it.
        -->
        <common:DiagnosticStateToBrushConverter x:Key="StateToBrush" />
    </Page.Resources>

    <!--
        Cards here are the same glass as Chop and Cutout, not the opaque CardBackground they used to
        be. The backdrop now runs behind every page from MainWindow, and an opaque card over a
        gradient reads as a hole punched in the page - the reasoning App.xaml records for the brush.
    -->
    <ScrollViewer Padding="24,16,24,32"
                  HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12" MaxWidth="820" HorizontalAlignment="Center">

            <StackPanel Spacing="2">
                <TextBlock Text="Settings" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="How the app looks, where it saves, and what this machine can do."
                           Style="{StaticResource HintText}" />
            </StackPanel>

            <!-- Status line. Assertive so a screen reader announces the result of a button press. -->
            <InfoBar IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                     Severity="Success"
                     IsClosable="True"
                     Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                     AutomationProperties.LiveSetting="Assertive" />

            <!-- ── Appearance ───────────────────────────────────────────────── -->
            <TextBlock Text="Appearance" Style="{StaticResource SectionHeading}" />

            <Border Style="{StaticResource GlassCard}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Theme" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="Applies straight away and is remembered next time."
                               Style="{StaticResource HintText}" />
                    <RadioButtons SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}"
                                  MaxColumns="3"
                                  AutomationProperties.Name="Application theme">
                        <RadioButton Content="Use system setting" />
                        <RadioButton Content="Light" />
                        <RadioButton Content="Dark" />
                    </RadioButtons>
                </StackPanel>
            </Border>

            <!-- ── Saving ───────────────────────────────────────────────────── -->
            <TextBlock Text="Saving" Style="{StaticResource SectionHeading}" />

            <Border Style="{StaticResource GlassCard}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Default folder" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.DefaultSaveFolder, Mode=OneWay}"
                                       Style="{StaticResource PathText}"
                                       Visibility="{x:Bind ViewModel.HasDefaultSaveFolder, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="Not set — the app asks every time."
                                       Style="{StaticResource HintText}"
                                       Visibility="{x:Bind ViewModel.HasDefaultSaveFolder, Mode=OneWay, Converter={StaticResource InvertedBoolToVis}}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="Choose…" Command="{x:Bind ViewModel.PickDefaultSaveFolderCommand}"
                                    AutomationProperties.Name="Choose the default save folder" />
                            <Button Content="Clear"
                                    Command="{x:Bind ViewModel.ClearDefaultSaveFolderCommand}"
                                    IsEnabled="{x:Bind ViewModel.HasDefaultSaveFolder, Mode=OneWay}"
                                    AutomationProperties.Name="Clear the default save folder" />
                        </StackPanel>
                    </Grid>

                    <ToggleSwitch IsOn="{x:Bind ViewModel.SaveWithoutAsking, Mode=TwoWay}"
                                  IsEnabled="{x:Bind ViewModel.HasDefaultSaveFolder, Mode=OneWay}"
                                  OnContent="Save straight to that folder"
                                  OffContent="Always ask where to save"
                                  MinWidth="0"
                                  AutomationProperties.Name="Skip the folder picker when saving a batch" />

                    <TextBlock Text="Only affects &quot;Save all&quot; on the Chop and Cutout pages. Saving a single clip or photo always asks, so a one-off never lands somewhere unexpected."
                               Style="{StaticResource HintText}" />
                </StackPanel>
            </Border>

            <!-- ── Sound and motion ─────────────────────────────────────────── -->
            <TextBlock Text="Sound and motion" Style="{StaticResource SectionHeading}" />

            <Border Style="{StaticResource GlassCard}">
                <StackPanel Spacing="12">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.CueSoundsEnabled, Mode=TwoWay}"
                                  OnContent="Cue sounds on"
                                  OffContent="Cue sounds off"
                                  MinWidth="0"
                                  AutomationProperties.Name="Play synthesised count-in and completion sounds" />

                    <TextBlock Style="{StaticResource HintText}"
                               Text="An audible count-in before recording, a chime when a batch finishes, and a quiet blip either side of a clip you audition. All generated on the fly — no sound files are shipped. Nothing ever sounds while the microphone is open, so a cue cannot end up inside a take." />

                    <MenuFlyoutSeparator />

                    <StackPanel Spacing="2">
                        <TextBlock Text="Motion" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.MotionStatusText}"
                                   Style="{StaticResource HintText}" />
                        <TextBlock Text="This follows the Windows &quot;Show animations&quot; setting rather than adding one of its own."
                                   Style="{StaticResource HintText}"
                                   Margin="0,4,0,0"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── Storage ──────────────────────────────────────────────────── -->
            <TextBlock Text="Storage" Style="{StaticResource SectionHeading}" />

            <Border Style="{StaticResource GlassCard}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Working files" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.ScratchSizeText, Mode=OneWay}"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.ScratchFolder}" Style="{StaticResource PathText}" />
                            <TextBlock Text="Decoded audio lives here while the app is open and is deleted on exit. Cleaning up removes only what earlier runs left behind — nothing on screen right now is touched."
                                       Style="{StaticResource HintText}" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                            <Button Content="Open"
                                    Command="{x:Bind ViewModel.OpenScratchFolderCommand}"
                                    AutomationProperties.Name="Open the working files folder in File Explorer" />
                            <Button Content="Clean up"
                                    Command="{x:Bind ViewModel.CleanUpScratchCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InvertBool}}"
                                    AutomationProperties.Name="Delete working files left by earlier runs" />
                        </StackPanel>
                    </Grid>

                    <MenuFlyoutSeparator />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Log file" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.LogDirectory}" Style="{StaticResource PathText}" />
                        </StackPanel>

                        <Button Grid.Column="1" Content="Open log folder"
                                VerticalAlignment="Center"
                                Command="{x:Bind ViewModel.OpenLogFolderCommand}"
                                AutomationProperties.Name="Open the log folder in File Explorer" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── Diagnostics ──────────────────────────────────────────────── -->
            <!-- Two real columns. As one cell the heading sat under the two buttons. -->
            <Grid Margin="2,8,0,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="What this machine can do"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Command="{x:Bind ViewModel.CopyDiagnosticsCommand}"
                            AutomationProperties.Name="Copy diagnostics to the clipboard"
                            ToolTipService.ToolTip="Copy every line below as text, ready to paste into a bug report">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                            <TextBlock Text="Copy" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.RefreshCommand}"
                            AutomationProperties.Name="Re-check what this machine can do">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="Re-check" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Diagnostics}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="10" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="services:DiagnosticSection">
                        <Border Style="{StaticResource GlassCard}"
                                AutomationProperties.Name="{x:Bind Title}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{x:Bind Title}" Style="{ThemeResource BodyStrongTextBlockStyle}" />

                                <ItemsControl ItemsSource="{x:Bind Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="services:DiagnosticItem">
                                            <!--
                                                The label column was a fixed 170px, which truncated
                                                the longer capability names outright. Auto sizes to
                                                the widest label instead, and the value column takes
                                                what is left.
                                            -->
                                            <Grid ColumnSpacing="10" Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" MaxWidth="220" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <shapes:Ellipse Grid.Column="0" Width="8" Height="8"
                                                         VerticalAlignment="Center"
                                                         Fill="{x:Bind State, Converter={StaticResource StateToBrush}}" />

                                                <TextBlock Grid.Column="1" Text="{x:Bind Label}"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           TextWrapping="Wrap"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                                <TextBlock Grid.Column="2" Text="{x:Bind Value}"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           TextWrapping="Wrap"
                                                           IsTextSelectionEnabled="True" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!-- ── About ────────────────────────────────────────────────────── -->
            <TextBlock Text="About" Style="{StaticResource SectionHeading}" />

            <Border Style="{StaticResource GlassCard}">
                <StackPanel Spacing="10">
                    <TextBlock Text="PoChopAudio" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock Style="{StaticResource HintText}"
                               Text="Splits recordings into one clip per take, and takes head shots and strips their backgrounds. Everything runs on this machine: there is no server, no account, and nothing is uploaded." />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Settings file" Style="{ThemeResource CaptionTextBlockStyle}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ViewModel.SettingsFilePath}" Style="{StaticResource PathText}" />
                        </StackPanel>

                        <Button Grid.Column="1" Content="Reset all settings"
                                VerticalAlignment="Center"
                                Command="{x:Bind ViewModel.ResetAllSettingsCommand}"
                                AutomationProperties.Name="Reset every setting on this page to its default" />
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>

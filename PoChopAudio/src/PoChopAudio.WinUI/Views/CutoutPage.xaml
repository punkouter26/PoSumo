<Page
    x:Class="PoChopAudio.WinUI.Views.CutoutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PoChopAudio.WinUI.Controls"
    xmlns:models="using:PoChopAudio.WinUI.Models"
    NavigationCacheMode="Required">

    <!--
        Converters and the card style live in App.xaml.

        NavigationCacheMode is Required for a reason specific to this page: without it, leaving and
        coming back destroyed the page and so tore down CameraService's MediaFrameReader and started
        a fresh one, which on many webcams means a visible second or two of black viewfinder for
        nothing.
    -->

    <!--
        AllowDrop is on the whole page, not on the viewfinder, so a photo can be dropped anywhere
        on it. The Chop page binds its own drop to a DropArea border because that page has a
        scroller's worth of other content; here the page has one job and dropping anywhere is
        unambiguous.
    -->
    <Grid AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <!--
                    The viewfinder was a hard Height="380". With a 56px shutter button under it and
                    the page header above, a short window - or the same window at 150% scaling -
                    pushed TAKE PHOTO below the fold, which is the one control this page exists for.
                    Short windows get a smaller viewfinder instead so the button stays reachable.
                -->
                <VisualState x:Name="TallWindow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowHeight="760" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Viewfinder.Height" Value="380" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup>
                <!-- Same hamburger collision as the Chop page: below the NavigationView's compact
                     breakpoint its menu button floats over the top-left of whatever page is
                     loaded, straight across the title. -->
                <VisualState x:Name="WideShell">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="641" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageScroller.Padding" Value="24,16,24,32" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!--
            Rows in a Grid rather than a StackPanel, with the repeater in one of them, so the
            ItemsRepeater below actually virtualizes - a StackPanel measures at infinite height and
            realizes every card, each of which owns a live Direct2D CutoutPreview.

            MaxWidth plus Center matches the Chop page. Stretch left this content hugging the left
            edge on a wide window while Chop centred its own, so the two pages did not line up.
        -->
        <ScrollViewer x:Name="PageScroller"
                      Padding="64,16,24,32"
                      HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid MaxWidth="1100" HorizontalAlignment="Center" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="2">
                    <TextBlock Text="Head shots" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock Text="Take a photo, or drop in one you already have, and the background comes off automatically. Nothing leaves this machine."
                               Style="{StaticResource HintText}" />
                </StackPanel>

                <!-- ── Camera ───────────────────────────────────────────────────── -->
                <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="20">
                    <StackPanel Spacing="16">

                        <Grid x:Name="Viewfinder" Height="240" CornerRadius="6"
                              Background="{ThemeResource LayerFillColorDefaultBrush}">
                            <Rectangle x:Name="ShutterFlash" Fill="White" Opacity="0" IsHitTestVisible="False"
                                       AutomationProperties.AccessibilityView="Raw" />
                            <Image x:Name="PreviewImage" Stretch="Uniform"
                                   AutomationProperties.Name="Live camera viewfinder"
                                   Visibility="{x:Bind ViewModel.IsCameraRunning, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                                        Visibility="{x:Bind ViewModel.IsCameraRunning, Mode=OneWay, Converter={StaticResource InvertedBoolToVis}}">
                                <FontIcon Glyph="&#xE722;" FontSize="36" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="Starting camera…" HorizontalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <Button x:Name="TakePhotoButton" Content="TAKE PHOTO" Style="{ThemeResource AccentButtonStyle}"
                                Click="OnTakePhotoVisualFeedback"
                                HorizontalAlignment="Stretch" Height="56" FontSize="16" FontWeight="SemiBold"
                                AutomationProperties.Name="Take a photo and remove its background"
                                Command="{x:Bind ViewModel.TakePhotoCommand}"
                                IsEnabled="{x:Bind ViewModel.IsCapturing, Mode=OneWay, Converter={StaticResource InvertBool}}" />

                        <!--
                            The way in for photos that already exist. Deliberately a secondary
                            button: the camera is still the primary act, and this must not read as
                            a competing accent. IsEnabled is bound to the same busy flag the camera
                            uses, because both paths write into Files and cut out through the one
                            CutoutService.
                        -->
                        <Button x:Name="ImportPhotosButton" Content="Import photos…"
                                HorizontalAlignment="Stretch" Height="40"
                                AutomationProperties.Name="Choose image files and remove their backgrounds"
                                Command="{x:Bind ViewModel.ImportPhotosCommand}"
                                IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InvertBool}}" />

                        <!--
                            The Health page used to be where a missing model was reported. With that page
                            gone this is the only place the user would find out, so it says so inline.
                        -->
                        <Border Background="{ThemeResource ErrorBannerBrush}" CornerRadius="6" Padding="12"
                                AutomationProperties.LiveSetting="Assertive"
                                Visibility="{x:Bind ViewModel.IsCutoutAvailable, Mode=OneWay, Converter={StaticResource InvertedBoolToVis}}">
                            <TextBlock TextWrapping="Wrap" FontWeight="SemiBold"
                                       Text="Background removal is unavailable: u2netp.onnx is missing. Run SCRIPTS/download-models.ps1, then restart." />
                        </Border>

                        <ProgressBar IsIndeterminate="True"
                                     AutomationProperties.Name="Working"
                                     Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" TextWrapping="Wrap"
                                   Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}"
                                   AutomationProperties.LiveSetting="Assertive"
                                   Foreground="{ThemeResource ErrorTextBrush}" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>

                <!-- ── Fine tune ────────────────────────────────────────────────── -->
                <Expander Grid.Row="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Header="Fine tune"
                          Expanding="OnExpanderExpanding" Collapsed="OnExpanderCollapsed"
                          Visibility="{x:Bind ViewModel.HasFiles, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <StackPanel Spacing="12">

                        <!-- Wraps instead of clipping the explanation off the right edge. -->
                        <controls:WrapPanel ItemWidth="300" ItemHeight="44" HorizontalSpacing="12" VerticalSpacing="4">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.Tuning.HeadOnly, Mode=TwoWay}"
                                          AutomationProperties.Name="Crop to the head only"
                                          OnContent="Head only" OffContent="Whole subject"
                                          MinWidth="0" VerticalAlignment="Center" />
                            <TextBlock VerticalAlignment="Center"
                                       Style="{StaticResource HintText}"
                                       Text="Crops off the neck, shoulders and body. Turn off to keep everything." />
                        </controls:WrapPanel>

                        <controls:WrapPanel ItemWidth="260" ItemHeight="72" HorizontalSpacing="16" VerticalSpacing="8">

                            <StackPanel Spacing="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Cutoff"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Tuning.AlphaThreshold, Mode=OneWay}"
                                               Style="{StaticResource KnobValueText}" />
                                </Grid>
                                <Slider Value="{x:Bind ViewModel.Tuning.AlphaThreshold, Mode=TwoWay}"
                                        AutomationProperties.Name="Background cutoff, 0 to 255"
                                        Minimum="0" Maximum="255" StepFrequency="5"
                                        ValueChanged="OnSliderValueChanged" />
                            </StackPanel>

                            <StackPanel Spacing="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Tighten / loosen"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Tuning.Morphology, Mode=OneWay}"
                                               Style="{StaticResource KnobValueText}" />
                                </Grid>
                                <Slider Value="{x:Bind ViewModel.Tuning.Morphology, Mode=TwoWay}"
                                        AutomationProperties.Name="Tighten or loosen the edge, in pixels"
                                        Minimum="-3" Maximum="3" StepFrequency="1"
                                        ValueChanged="OnSliderValueChanged" />
                            </StackPanel>

                            <StackPanel Spacing="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Soften edge"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Tuning.FeatherRadius, Mode=OneWay}"
                                               Style="{StaticResource KnobValueText}" />
                                </Grid>
                                <Slider Value="{x:Bind ViewModel.Tuning.FeatherRadius, Mode=TwoWay}"
                                        AutomationProperties.Name="Soften the edge, in pixels"
                                        Minimum="0" Maximum="5" StepFrequency="1"
                                        ValueChanged="OnSliderValueChanged" />
                            </StackPanel>

                            <StackPanel Spacing="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Head cut (%)"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Tuning.HeadCutBias, Mode=OneWay}"
                                               Style="{StaticResource KnobValueText}" />
                                </Grid>
                                <Slider Value="{x:Bind ViewModel.Tuning.HeadCutBias, Mode=TwoWay}"
                                        AutomationProperties.Name="Move the neck line, as a percentage"
                                        Minimum="-40" Maximum="40" StepFrequency="5"
                                        ValueChanged="OnSliderValueChanged" />
                            </StackPanel>

                            <StackPanel Spacing="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Padding (px)"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Tuning.CropPadding, Mode=OneWay}"
                                               Style="{StaticResource KnobValueText}" />
                                </Grid>
                                <Slider Value="{x:Bind ViewModel.Tuning.CropPadding, Mode=TwoWay}"
                                        AutomationProperties.Name="Padding around the crop, in pixels"
                                        Minimum="0" Maximum="200" StepFrequency="4"
                                        ValueChanged="OnSliderValueChanged" />
                            </StackPanel>

                            <StackPanel Spacing="2">
                                <TextBlock Text="Edge" Style="{ThemeResource CaptionTextBlockStyle}" />
                                <ToggleSwitch IsOn="{x:Bind ViewModel.Tuning.HardEdge, Mode=TwoWay}"
                                              AutomationProperties.Name="Use a sharp edge rather than a soft one"
                                              OnContent="Sharp" OffContent="Soft" MinWidth="0" />
                            </StackPanel>
                        </controls:WrapPanel>

                        <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                            <Button Content="Re-apply to all" Style="{ThemeResource AccentButtonStyle}"
                                    AutomationProperties.Name="Re-cut every photo with these settings"
                                    Command="{x:Bind ViewModel.ReapplyAllCommand}" />
                            <Button Content="Reset" Command="{x:Bind ViewModel.ResetTuningCommand}"
                                    AutomationProperties.Name="Reset the fine-tune settings" />
                        </controls:WrapPanel>

                        <TextBlock Style="{StaticResource HintText}"
                                   Text="Cutoff decides what counts as background. Sharp edge removes the halo around hair; soften only if it looks too cut-out. Head cut moves the neck line up or down." />
                    </StackPanel>
                </Expander>

                <!-- An empty results area reads as a bug; saying so is cheaper than wondering. -->
                <Border Grid.Row="3" Style="{StaticResource GlassCard}" Padding="24"
                        Visibility="{x:Bind ViewModel.HasFiles, Mode=OneWay, Converter={StaticResource InvertedBoolToVis}}">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE722;" FontSize="28" HorizontalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="No photos yet" HorizontalAlignment="Center"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Line yourself up in the viewfinder above and press TAKE PHOTO, drop image files anywhere on this page, or pick them with Import photos. Each shot appears here with its background already removed."
                                   Style="{StaticResource HintText}"
                                   TextAlignment="Center" MaxWidth="440" />
                    </StackPanel>
                </Border>

                <!-- ── Results ──────────────────────────────────────────────────── -->
                <!-- Two real columns. As one cell the heading sat underneath the buttons. -->
                <Grid Grid.Row="4" ColumnSpacing="12"
                      Visibility="{x:Bind ViewModel.HasFiles, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Results" Style="{ThemeResource SubtitleTextBlockStyle}"
                               VerticalAlignment="Center" />
                    <controls:WrapPanel Grid.Column="1" HorizontalSpacing="8" VerticalSpacing="8">
                        <Button Content="Save all to folder..." Command="{x:Bind ViewModel.SaveAllToFolderCommand}"
                                AutomationProperties.Name="Save every cut-out into a folder" />
                        <Button Content="Clear" Command="{x:Bind ViewModel.ClearAllCommand}"
                                AutomationProperties.Name="Discard every photo taken so far" />
                    </controls:WrapPanel>
                </Grid>

                <!--
                    ItemsRepeater, not ItemsControl: every card carries a CutoutPreview, which is a
                    live Direct2D surface holding two decoded bitmaps. Realizing all of them at once
                    is the most expensive thing this page could do. See EnsureSurface in
                    CutoutPreview for what recycling required.
                -->
                <ItemsRepeater Grid.Row="5" ItemsSource="{x:Bind ViewModel.Files}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="12" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:CutoutFileItem">
                            <Border Style="{StaticResource GlassCard}" Padding="16">
                                <StackPanel Spacing="12">

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{x:Bind FileName, Mode=OneWay}"
                                                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind DetailsText, Mode=OneWay}"
                                                       Style="{StaticResource HintText}" />
                                        </StackPanel>

                                        <Button Grid.Column="1" Content="Save PNG..."
                                                Command="{x:Bind Owner.SaveSingleCutoutCommand}"
                                                CommandParameter="{x:Bind}"
                                                VerticalAlignment="Top"
                                                AutomationProperties.Name="{x:Bind FileName, Mode=OneWay, Converter={StaticResource RowLabel}, ConverterParameter=Save as a PNG:}" />
                                    </Grid>

                                    <controls:CutoutPreview Item="{x:Bind}" Loaded="OnCardVisualLoaded" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

            </Grid>
        </ScrollViewer>

        <!-- Fires once per captured frame, as a shutter acknowledgement. -->
        <controls:ParticleBurst x:Name="Confetti" />
    </Grid>
</Page>

# Unity generated
/Library/
/Temp/
/Logs/
/obj/
/UserSettings/
/MemoryCaptures/
/Recordings/

# IDE / generated project files
*.csproj
*.slnx
*.sln
.vscode/
.idea/

# Build outputs (APKs etc. are artifacts, rebuild from source)
/Builds/
# Editor "build" scratch dir — Unity writes stop-build logs here. Artifact, not source.
/build/

# Art AUTHORING input, not build input. The shipped sprites are the PNGs under
# Assets/Resources/Faces; these are the JPEG originals they were cut from. It was
# 14 MB tracked for exactly ONE fighter of four (Kim) — Matt's and Nick's originals
# were never committed and Standard has no face art at all — so tracking it bought
# no reproducibility, only weight. Kept on disk, out of git.
/SourceArt/

# Misfired deploy target: DeployBrain writes to Assets/Agents/<Name>_v01/, and a
# copy landing at the REPO ROOT is outside Assets/ where Unity never sees it. One
# was tracked for months holding a stale Matt brain that looked current.
/Matt_v01/

# Python training environment (rebuild from Training/ml-agents source; see CLAUDE.md pins)
/Training/venv/
# Tooling venv for Tools/play_publish.py. Reproducible from
# Tools/requirements-publish.txt, so it is disposable like every other venv here.
/Tools/publish-venv/

# Training run outputs (checkpoints/TensorBoard; deployed models live in Assets/Agents/)
/Training/results/

# Trunk checkpoints kept only as --initialize-from sources (outside the TB logdir)
/Training/trunks/

# Live session record written by Start-Training.ps1 (PIDs and ports — machine-local)
/Training/.session.json

# OS noise
Thumbs.db
.DS_Store

# Python bytecode. Tools/unity.py is run directly, so its cache was getting
# committed as a binary blob on every edit.
__pycache__/
*.pyc

# Android build intermediates
/.utmp/

# Training supervision logs and archived experiment runs
/Training/logs/
/Training/results_archive/

# ML-Agents auto-generated profiling output (regenerated every play/run).
# The whole folder is generated — it was committed once and still listed retired
# scenes (SCN_TRAIN_DAVE, SCN_SUMO_ICE, SCN_SUMO_STICKY) long after they were gone.
/Assets/ML-Agents/
/Assets/ML-Agents.meta

# Editor crash-recovery scene backups
/Assets/_Recovery/
/Assets/_Recovery.meta

# Verification screenshots (regenerated on demand via UnitySkills scene_screenshot)
/Assets/Screenshots/
/Assets/Screenshots.meta

# com.unity.test-framework.performance scratch state. Rewritten on every test run
# and it lands in Assets/Resources/, so tracking it means shipping a machine's
# package list and editor changeset inside the APK for no reason.
/Assets/Resources/PerformanceTestRunInfo.json
/Assets/Resources/PerformanceTestRunInfo.json.meta
/Assets/Resources/PerformanceTestRunSettings.json
/Assets/Resources/PerformanceTestRunSettings.json.meta

# Generated by com.ivanmurzak.unity.mcp (Editor/Scripts/Utils/LinkExtractor.cs) on
# every package resolve. It force-preserves the MCP/SignalR/Roslyn assemblies from
# IL2CPP stripping — the exact assemblies FixPluginPlatforms.cs keeps OUT of player
# builds. Regenerated, never authored; do not track it.
/Assets/packages-merged-link/
/Assets/packages-merged-link.meta
Training/*.log

# Claude Code per-session scratch. These are rewritten on every session (and by
# hooks mid-session), so tracking them put a permanent M/D/?? block in every
# `git status` and produced merge noise that never meant anything. `.gitkeep`
# stays tracked so the directory itself survives a clone.
.claude/state/*
!.claude/state/.gitkeep
